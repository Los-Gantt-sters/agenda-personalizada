# ==============================================================================
# Agensible - CEE Fundación Purísima Concepción
# Plantilla de Variables de Entorno Seguras (Supabase BaaS & API Keys)
# ==============================================================================
# NOTA DE SEGURIDAD (RNF15.3):
# Nunca comitees el archivo .env real con claves de producción.
# Copia este archivo como .env.local para tu entorno de desarrollo.

# URL base del proyecto Supabase (BaaS)
VITE_SUPABASE_URL=https://tu-proyecto-purisima.supabase.co

# Clave pública anónima (anon public key) con Row Level Security activado
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_key

# Entorno de ejecución (development | production)
VITE_APP_ENV=development

# URL de la API de Pictogramas ARASAAC (Recurso Abierto)
VITE_ARASAAC_API_URL=https://api.arasaac.org/api/pictograms
