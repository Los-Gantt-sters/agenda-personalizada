# ==============================================================================
# Agensible - CEE Fundación Purísima Concepción
# Plantilla de Variables de Entorno Seguras (Supabase BaaS & API Keys)
# ==============================================================================
# NOTA DE SEGURIDAD (RNF15.3):
# Nunca comitees el archivo .env real con claves de producción.
# Copia este archivo como .env.local para tu entorno de desarrollo.

# URL base del proyecto Supabase (BaaS)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto-purisima.supabase.co

# Clave pública anónima (anon public key) con Row Level Security activado
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_key

# Entorno de ejecución (development | production)
EXPO_PUBLIC_APP_ENV=development

# URL de la API de Pictogramas ARASAAC (Recurso Abierto)
EXPO_PUBLIC_ARASAAC_API_URL=https://api.arasaac.org/api/pictograms

# Modo tableta personal: "true" si la tableta pertenece a un único estudiante
EXPO_PUBLIC_MODO_TABLETA_PERSONAL=false

# Visita con QR (HU-15): sitios cuyos enlaces se pueden abrir desde un código QR, separados por comas
# (también valen sus subdominios). Si se deja vacía, la app NO abre ningún enlace de un QR: así un
# QR pegado encima del de una puerta no puede llevar a un menor a cualquier web.
EXPO_PUBLIC_QR_SITIOS_PERMITIDOS=fundacionpurisima.es
